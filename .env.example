# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug

API_PORT=3000

DATABASE_URL=postgres://probeboard:probeboard@localhost:5432/probeboard
DATABASE_POOL_MAX=10

# Secret request headers (M2). Required, no default -- this repo will refuse
# to boot without it. The value below is a local-dev-only key, fine to use
# as-is after `cp .env.example .env`; generate your own with
# `openssl rand -base64 32` for anything beyond a laptop.
HEADER_ENCRYPTION_KEY=VGfyiTyeff5ZbLltgSFvbqwopxVg6IdJIkAe9dX55XU=

PROBE_MAX_BODY_BYTES=65536
PROBE_MAX_TIMEOUT_MS=30000

WORKER_ID=worker-local
SCHEDULER_TICK_MS=1000
SCHEDULER_BATCH_SIZE=100
SCHEDULER_LEASE_MS=60000
# Loading the monitor -- endpoint, service and headers, then decryption -- is
# not free, so it is a named term in the lease arithmetic rather than assumed
# to be zero. A load that overruns releases the row without probing.
SCHEDULER_LOAD_BUDGET_MS=1500
# Teardown and the release round trip. The one judged term in the lease.
SCHEDULER_LEASE_SLACK_MS=15000
# How long a graceful stop waits for in-flight probes. Pairs with the worker's
# stop_grace_period in docker-compose.yml: raising this without raising that
# turns every graceful stop into a SIGKILL.
SCHEDULER_SHUTDOWN_GRACE_MS=35000
# Spread over a newly adopted endpoint's first slot, so monitors created
# together do not share a phase for ever. 0 disables it.
SCHEDULER_ADOPT_JITTER_MAX_S=60
PROBE_CONCURRENCY=50

# Leave true. Set false only to probe a local test server (docs §7.4).
SSRF_GUARD_ENABLED=true
# Rejected even on an otherwise-public host, save-time (M2) and connect-time
# (M3) alike -- see the default list's own comment in schema.ts.
# SSRF_BLOCKED_PORTS=25,111,135,139,445,1433,1521,2375,2376,3306,3389,5432,5984,6379,7000,9200,9300,11211,27017

# Sign in with Google or GitHub. Off unless configured -- a client id with no
# secret (or vice versa) fails at boot, and OAUTH_ENABLED refuses to turn on
# with no provider configured or no base URL set.
#
# This same file is also what `docker compose` reads to interpolate
# ${GOOGLE_CLIENT_ID:-placeholder-client-id} etc. in docker-compose.yml --
# uncomment and fill these in to make `docker compose up` redirect to a real
# provider instead of a placeholder (tracker.md F1/F2).
OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:3000
# WEB_BASE_URL=http://127.0.0.1:5173
