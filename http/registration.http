### api/registration — services and endpoints
#
# Run auth.http's register + login first so the client's cookie jar carries a
# session; every request here reuses it. The endpoints section acts on the
# service the services section creates -- run top to bottom.

@baseUrl = {{$dotenv baseUrl}}

### Services

###
# @name createExplicit
# 201. Explicit form: {name, baseUrl}. baseUrl is normalized to its origin --
# scheme + host [+ port], no path -- even if you paste one with a path.
POST {{baseUrl}}/v1/services
Content-Type: application/json

{
  "name": "Example API",
  "baseUrl": "https://93.184.216.34",
  "headers": [
    { "name": "X-Client-Id", "value": "probeboard", "isSecret": false },
    { "name": "X-Api-Key", "value": "replace-me", "isSecret": true }
  ],
  "tags": [{ "key": "env", "value": "prod" }]
}

###
# @name createDuplicateBaseUrl
# 409 CONFLICT: the explicit form does not silently attach like B-3's does.
POST {{baseUrl}}/v1/services
Content-Type: application/json

{
  "name": "Same origin again",
  "baseUrl": "https://93.184.216.34"
}

###
# @name createImplicitNewOrigin
# 201, {service, endpointId}. B-3: a bare URL creates a service at its origin
# plus one endpoint at its path, in one transaction.
POST {{baseUrl}}/v1/services
Content-Type: application/json

{
  "url": "https://93.184.216.35/v1/orders"
}

###
# @name createImplicitExistingOrigin
# 201, same service.id as createImplicitNewOrigin -- attaches a second
# endpoint instead of duplicating the service.
POST {{baseUrl}}/v1/services
Content-Type: application/json

{
  "url": "https://93.184.216.35/v1/users"
}

###
# @name rejectScheme
# 400 SCHEME_NOT_ALLOWED, before any DNS lookup.
POST {{baseUrl}}/v1/services
Content-Type: application/json

{
  "name": "ftp",
  "baseUrl": "ftp://93.184.216.34"
}

###
# @name rejectCredentials
# 400 CREDENTIALS_IN_URL.
POST {{baseUrl}}/v1/services
Content-Type: application/json

{
  "name": "creds",
  "baseUrl": "https://user:pass@93.184.216.34"
}

###
# @name rejectLoopback
# 400 ADDRESS_NOT_ALLOWED -- a private/loopback/link-local/metadata address,
# literal or resolved, at save time (docs/m2-plan.md §5.1, §6).
POST {{baseUrl}}/v1/services
Content-Type: application/json

{
  "name": "loopback",
  "baseUrl": "http://127.0.0.1"
}

###
# @name list
# 200, an array. Only the signed-in account's own services.
GET {{baseUrl}}/v1/services

###
# @name listByTag
# B-5: "key:value", split on the first colon only. createExplicit's own
# {env: prod} tag matches; a non-matching tag returns [], not an error.
GET {{baseUrl}}/v1/services?tag=env:prod

###
# @name listByMalformedTag
# 400 VALIDATION_FAILED -- no colon in the filter.
GET {{baseUrl}}/v1/services?tag=noColonHere

###
# @name get
# Replace :id with createExplicit's response id.
GET {{baseUrl}}/v1/services/:id

###
# @name update
# 200. headers/tags, if present, fully replace the existing set. The secret
# header above is kept (not shown, not touched) by naming it with no `value`.
PATCH {{baseUrl}}/v1/services/:id
Content-Type: application/json

{
  "name": "Example API (renamed)",
  "headers": [
    { "name": "X-Client-Id", "value": "probeboard-v2", "isSecret": false },
    { "name": "X-Api-Key", "isSecret": true }
  ]
}

###
# @name updateRejectsLoopback
# 400 ADDRESS_NOT_ALLOWED -- baseUrl is re-validated on every save (D10), not
# only at create.
PATCH {{baseUrl}}/v1/services/:id
Content-Type: application/json

{
  "baseUrl": "http://127.0.0.1"
}

###
# @name listEndpointsForService
GET {{baseUrl}}/v1/services/:id/endpoints

### Endpoints

###
# @name create
# 201. method/path default to GET / when omitted. interval/timeout/redirects
# default from config when omitted (FR-7/FR-8/FR-21 -- system-configurable,
# not a fixed constant). Replace :serviceId with createExplicit's id.
POST {{baseUrl}}/v1/services/:serviceId/endpoints
Content-Type: application/json

{
  "method": "GET",
  "path": "/health",
  "headers": [{ "name": "x-client-id", "value": "endpoint-override", "isSecret": false }],
  "tags": [{ "key": "critical", "value": "true" }]
}

###
# @name effectiveHeaders
# The response's effectiveHeaders shows the endpoint's x-client-id winning
# over the service's X-Client-Id, case-insensitively (B-4) -- read it off
# create's own response, or re-fetch below.

###
# @name createDuplicate
# 409 CONFLICT -- same (service, method, path) as `create`.
POST {{baseUrl}}/v1/services/:serviceId/endpoints
Content-Type: application/json

{
  "method": "GET",
  "path": "/health"
}

###
# @name rejectDisallowedInterval
# 400 VALIDATION_FAILED -- FR-7: interval is one of PROBE_ALLOWED_INTERVALS_S,
# not an arbitrary integer.
POST {{baseUrl}}/v1/services/:serviceId/endpoints
Content-Type: application/json

{
  "method": "GET",
  "path": "/other",
  "intervalS": 7
}

###
# @name createWithJsonPathAssertion
# 201. The supported json_path subset: dot-separated names and [0] indices.
# `$` may lead the path or be omitted -- `$.data.status` and `data.status`
# address the same value.
POST {{baseUrl}}/v1/services/:serviceId/endpoints
Content-Type: application/json

{
  "method": "GET",
  "path": "/orders",
  "assertions": [
    { "type": "json_path", "path": "$.data.items[0].status", "equals": "ok" },
    { "type": "body_contains", "value": "\"ok\"" }
  ]
}

###
# @name rejectUnsupportedJsonPath
# 400 VALIDATION_FAILED -- `$.items[*].id` is a perfectly ordinary JSONPath
# expression and the probe evaluator cannot express it. Accepting it here
# would store a monitor that reports permanent false downtime from its first
# probe, so the accepted grammar is enforced at save time and published as
# the field's `pattern` in openapi.yaml (docs/m3-plan.md D36/D42/D52).
POST {{baseUrl}}/v1/services/:serviceId/endpoints
Content-Type: application/json

{
  "method": "GET",
  "path": "/wildcard",
  "assertions": [{ "type": "json_path", "path": "$.items[*].id", "equals": 1 }]
}

###
# @name getEndpoint
# Replace :id with create's response id.
GET {{baseUrl}}/v1/endpoints/:id

###
# @name listForService
GET {{baseUrl}}/v1/services/:serviceId/endpoints

###
# @name listForServiceByTag
# B-5: create's own {critical: true} tag matches.
GET {{baseUrl}}/v1/services/:serviceId/endpoints?tag=critical:true

###
# @name listAll
# Every endpoint the signed-in account owns, across services.
GET {{baseUrl}}/v1/endpoints

###
# @name listAllByTag
GET {{baseUrl}}/v1/endpoints?tag=critical:true

###
# @name updateEndpoint
# 200. path/method re-validate the joined base+path against the SSRF guard
# unconditionally (D10), even when neither actually changed.
PATCH {{baseUrl}}/v1/endpoints/:id
Content-Type: application/json

{
  "timeoutMs": 5000,
  "failureThreshold": 5
}

###
# @name pause
# 200, enabled: false. Inert until M4's scheduler reads it (FR-9).
POST {{baseUrl}}/v1/endpoints/:id/pause

###
# @name resume
# 200, enabled: true.
POST {{baseUrl}}/v1/endpoints/:id/resume

###
# @name deleteEndpoint
# 204.
DELETE {{baseUrl}}/v1/endpoints/:id

## Not here: the endpoint quota (B-8, ENDPOINT_QUOTA_PER_USER, default 100).
## Exceeding it means sending more requests than is useful to page through by
## hand; the behavior is covered by the integration suite instead.

### Services, continued -- delete after endpoints, so cascade delete's own
### effect on endpoints/headers/tags is exercised only once, deliberately.

###
# @name delete
# 204. Cascades to the service's endpoints, headers and tags.
DELETE {{baseUrl}}/v1/services/:id

###
# @name getAfterDelete
# 404.
GET {{baseUrl}}/v1/services/:id
