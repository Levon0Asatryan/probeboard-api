# Variables for the .http files in this folder, read as {{$dotenv name}}.
#
# Checked in, and the .gitignore rule for .env files carries an exception for
# this one, because it holds no secret: every value is a local development
# fixture pointing at a stack you started yourself. Never put a real
# credential here -- if you need one, use `.env.local`, which stays ignored.

baseUrl = http://127.0.0.1:3000

# The account the requests act on. Register it once with the first request in
# auth.http; every later request reuses it.
email = dev@example.com
password = correct horse battery staple

# Used by the change-password requests, which change to it and back.
newPassword = a different development password

# A second account, for the checks that need one login not to affect another.
otherEmail = other@example.com
otherPassword = second development password

# A syntactically valid token that was never issued, for proving the guard
# rejects a forged cookie rather than merely a missing one.
forgedToken = pbs_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# The cookie name follows COOKIE_SECURE: __Host-pb_session when the cookie is
# Secure, pb_session otherwise. docker-compose.yml sets COOKIE_SECURE=false, so
# over plain http://127.0.0.1 it is the bare name.
cookieName = pb_session
