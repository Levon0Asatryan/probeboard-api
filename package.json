{
  "name": "probeboard-api",
  "version": "0.1.0",
  "private": true,
  "description": "probeboard API and probe worker",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/core/db/migrations && cp src/core/db/migrations/*.sql dist/core/db/migrations/",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/core/db/migrator/cli.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/core/db/migrator/cli.ts down",
    "migrate:dist": "node dist/core/db/migrator/cli.js up",
    "migrate:down:dist": "node dist/core/db/migrator/cli.js down",
    "audit:json-path-assertions": "tsx --env-file-if-exists=.env src/core/db/maintenance/audit-json-path-assertions.cli.ts",
    "audit:json-path-assertions:dist": "node dist/core/db/maintenance/audit-json-path-assertions.cli.js",
    "openapi": "tsx --env-file-if-exists=.env src/api/openapi/cli.ts",
    "openapi:check": "tsx --env-file-if-exists=.env src/api/openapi/cli.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run openapi:check && npm test",
    "prepare": "husky",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.integration.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@node-rs/argon2": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "kysely": "^0.29.6",
    "nestjs-pino": "^5.2.0",
    "openid-client": "6.8.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "multer": "^2.3.0"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
